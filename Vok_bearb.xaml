<Window x:Class="Vokabeltrainer.Vok_bearb"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Vokabeltrainer"
        mc:Ignorable="d"
        Loaded="Window_Loaded"
        Title="Vok_bearb" Height="450" Width="800">
    <Grid>
        <StackPanel>
            <Canvas Height="30" Background="LightGray">
                <Button Click="add_Click" x:Name="add" Content="Hinzufügen" Canvas.Left="10" HorizontalAlignment="Center" VerticalAlignment="Top" Canvas.Top="5"/>
                <Button Click="del_Click" x:Name="del" Content="Entfernen" Canvas.Left="91" HorizontalAlignment="Left" VerticalAlignment="Top" Canvas.Top="5"/>
                <Button Click="save_Click" x:Name="save" Content="Speichern" Canvas.Left="163" Canvas.Top="5" HorizontalAlignment="Left" VerticalAlignment="Center"/>

            </Canvas>
            <Canvas>
                <ScrollViewer>
                    <DataGrid x:Name="Datagrid_Vokabeln" d:ItemsSource="{d:SampleData ItemCount=5}" Height="385" Width="776"/>
                </ScrollViewer>
            </Canvas>
        </StackPanel>
    </Grid>
</Window>
